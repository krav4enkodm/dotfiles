{
  "chrome-devtools": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--headless",
      "--executablePath",
      "/usr/bin/chromium",
      "--viewport",
      "1440x900",
      "--chromeArg=--remote-debugging-port=9333"
    ],
    "env": {}
  }
}
