{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh stack merge *)",
      "Bash(gh stack unstack *)",
      "Bash(gh stack submit *--open*)"
    ],
    "ask": [
      "Bash(gh pr comment *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr review *)",
      "Bash(gh api *comments*)",
      "Bash(gh api *reviews*)",
      "Bash(gh api graphql *)"
    ]
  },
  "model": "opus[1m]",
  "theme": "dark",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/bash-guard.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
